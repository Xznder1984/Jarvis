# ------------------------------------------------------------------
# JARVIS — environment configuration
# Copy to .env and fill in the keys you want to use.
#   cp .env.example .env
# Keys marked (required) are needed before that provider can be used.
# Everything else is optional and can be added later from the Settings UI.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# LLM providers
# JARVIS routes across these in priority order (editable in Settings).
# At least one paid/cloud key OR a running local Ollama instance is
# needed. Local Ollama is the automatic last-resort fallback.
# ------------------------------------------------------------------

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenCode Zen — https://opencode.ai
OPENCODE_ZEN_API_KEY=

# Ollama Cloud — https://ollama.com (account required)
OLLAMA_CLOUD_API_KEY=

# Ollama (local) — no key needed; set base URL if non-default
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Default model per provider (can be overridden in Settings)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama-3.3-70b-versatile
OPENCODE_ZEN_MODEL=
OLLAMA_CLOUD_MODEL=llama3.2

# Credit fallback threshold (0..1). When a provider's estimated
# remaining credit drops below this fraction of its free tier it is
# treated as "low" and JARVIS fails over. Default 0.10.
CREDIT_LOW_THRESHOLD=0.10

# ------------------------------------------------------------------
# TTS — Fish Audio is primary; local system TTS is automatic fallback.
# ------------------------------------------------------------------
FISH_AUDIO_API_KEY=
# Fish Audio voice id. Empty = JARVIS (MCU) voice.
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=fishaudio/fish-speech-1.5
# Local fallback voice name (macOS `say` voice). "Daniel" = closest to JARVIS.
LOCAL_TTS_VOICE=Daniel
LOCAL_TTS_RATE=170

# ------------------------------------------------------------------
# Speech-to-text (local, free — faster-whisper)
# ------------------------------------------------------------------
STT_MODEL=base
STT_DEVICE=cpu

# ------------------------------------------------------------------
# Web search
# ------------------------------------------------------------------
# SERPAPI_API_KEY=
# BRAVE_API_KEY=

# ------------------------------------------------------------------
# Backend server
# ------------------------------------------------------------------
JARVIS_WS_HOST=127.0.0.1
JARVIS_WS_PORT=8765
JARVIS_LOG_LEVEL=INFO
# Log directory (backend + shell logs live here)
JARVIS_LOG_DIR=~/.jarvis/logs
JARVIS_LOG_MAX_BYTES=5242880
JARVIS_LOG_BACKUPS=3

# ------------------------------------------------------------------
# Voice capture (streamed from the shell to the backend over WS)
# ------------------------------------------------------------------
# Seconds to ignore mic audio right after a wake (so the wake response isn't
# transcribed back). The shell discards audio during this grace window.
CLAP_GRACE_MS=2200
# Silence needed (ms) before a spoken turn is considered finished.
UTTERANCE_SILENCE_MS=900
# Hard cap on a single spoken turn (ms) to avoid infinite capture.
UTTERANCE_MAX_MS=15000
# RMS floor (0..1) below which the shell treats audio as silence.
VAD_FLOOR=0.008
# Clap detection sensitivity (0..1) and window for N claps. Higher = quieter
# claps wake it (0.5 default detects soft claps; lower to ignore them).
CLAP_SENSITIVITY=0.5

# ------------------------------------------------------------------
# Idle / power saving (opt-in, off by default)
# ------------------------------------------------------------------
# After a session ends, if the app stays idle this long (ms), JARVIS triggers
# IDLE_ACTION. 0 disables.
IDLE_TIMEOUT_MS=0
# one of: off | sleep | shutdown
IDLE_ACTION=off
